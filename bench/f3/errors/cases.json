    {
      "id": "timeout-ttfb",
      "group": "timeout-retry",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--base-url", "{server}/slow-header/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "1", "--output", "json"],
      "setup": [],
      "expect_exit_nonzero": true,
      "what_user_should_learn": "Provider yang diam harus berakhir sebagai timeout TTFB dengan deadline yang disebut."
    },
    {
      "id": "timeout-dial",
      "group": "timeout-retry",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--base-url", "http://10.255.255.1/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "1", "--output", "json"],
