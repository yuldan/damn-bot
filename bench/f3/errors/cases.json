      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--base-url", "{server}/rate-limit/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "3", "--output", "json"],
      "setup": [],
      "expect_exit_nonzero": true,
