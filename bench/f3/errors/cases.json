    },
    {
      "id": "retry-server-error",
      "group": "timeout-retry",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--base-url", "{server}/server-error/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "3", "--output", "json"],
      "setup": [],
      "expect_exit_nonzero": true,
      "what_user_should_learn": "Error 500 harus di-retry lalu berhenti dengan jumlah percobaan yang terlihat."
    },
    {
      "id": "retry-unavailable",
      "group": "timeout-retry",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--base-url", "{server}/unavailable/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "3", "--output", "json"],
      "setup": [],
      "expect_exit_nonzero": true,
      "what_user_should_learn": "Service unavailable harus dibedakan dari bad request dan berhenti setelah retry."
    },
    {
      "id": "tool-unknown",
      "group": "tool-args",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--config", "{tmp}/loop.toml", "--base-url", "{server}/tool-unknown/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "1", "--output", "stream-json"],
      "setup": [{"op": "write", "path": "{tmp}/loop.toml", "content": "[loop]\nmax_iterations = 1\n"}],
      "expect_exit_nonzero": true,
      "what_user_should_learn": "Nama tool yang tidak dikenal harus menyebut tool dan memberi hint daftar tool."
    },
    {
      "id": "tool-bad-json",
      "group": "tool-args",
      "argv": ["run", "-p", "hi", "--model", "openai/fake", "--data-dir", "{tmp}/data", "--config", "{tmp}/loop.toml", "--base-url", "{server}/tool-badargs/v1", "--api-key", "f3-dummy-key", "--provider-attempts", "1", "--output", "stream-json"],
      "setup": [{"op": "write", "path": "{tmp}/loop.toml", "content": "[loop]\nmax_iterations = 1\n"}],
      "expect_exit_nonzero": true,
      "what_user_should_learn": "Argumen tool yang bukan JSON harus ditolak sebagai invalid_args dengan hint format."
    },
    {
