# Budget LOC Go non-test per paket (ENGINEERING §2.4 E-19, tabel core; scc --no-gen, kolom Code).
# Format: <grup> <LOC maks> <direktori...>. Sebuah file dihitung ke grup dengan prefix direktori terpanjang.
loop              1500 internal/loop
plan               600 internal/plan
provider          2000 internal/provider
provider/registry  400 internal/provider/registry
netx              1800 internal/netx
schema            1200 internal/schema
tools             1800 internal/tools
codetools         4500 internal/codetools
# ADR-081: exec 3000 -> 3500 + exec/classify 1500 (Σ core 31.450 -> 33.450 <= 47.000).
# ADR-106 butir 10: exec 3500 -> 3400, exec/classify 1500 -> 1600 (Σ core tetap).
exec              3400 internal/exec
exec/classify     1600 internal/exec/classify
# ADR-097 butir 12: sandbox+redact 1300 -> 1450 (S16-7, codetools deny fast path, redact prefilter; Σ core 33.750 -> 33.900).
sandbox+redact    1450 internal/sandbox internal/redact
boundary           150 internal/boundary
# ctxdb: ADR-049 (2.800) → ADR-087 (3.100).
ctxdb             3100 internal/ctxdb
# ADR-074: storage konsumen di internal/ctxdb/<consumer>store, dipotong dari baris konsumennya (Σ tidak berubah oleh ADR-074).
# ctxdb/gwstore (900) dihitung dari budget gateway SPEC §3.2.4; barisnya ditambah saat baris gateway dibuat (F4).
ctxdb/ledgerstore  300 internal/ctxdb/ledgerstore
ctxdb/memstore     600 internal/ctxdb/memstore
ctxdb/skillstore   400 internal/ctxdb/skillstore
ctxdb/journalstore 400 internal/ctxdb/journalstore
assemble          1000 internal/assemble
compaction         900 internal/compaction
memory+skills     1200 internal/memory internal/skills
journal            500 internal/journal
budget             400 internal/budget
heal              1500 internal/heal
config            1200 internal/config
modules            1000 internal/modules
hooks              700 internal/hooks
i18n               300 internal/i18n
# Infra non-produksi, di luar Σ core (ADR-086 NEW-34): helper test (timing ≤ 80, ADR-073), matriks
# import archtest (allowed.go), analyzer khusus go/analysis (modul tools, ADR-094).
testutil/timing     80 internal/testutil/timing
testutil           200 internal/testutil
archtest           300 internal/archtest
analyzers          400 tools/analyzers
# Paket test-only yang dikecualikan dari rasio test:source E-70 (ADR-098); LOC-nya tetap dihitung
# budget di atas dan dilaporkan terpisah oleh `make loc-ratio`. Format: TESTONLY <direktori>
TESTONLY internal/archtest
TESTONLY internal/testutil
# File generated yang dikecualikan dari hitungan (AUD-073): hanya glob path di bawah (saat ini kosong).
