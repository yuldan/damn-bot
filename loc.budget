# Budget LOC Go non-test per paket (ENGINEERING §2.4 E-19, tabel core; scc --no-gen, kolom Code).
# Format: <grup> <LOC maks> <direktori...>. Sebuah file dihitung ke grup dengan prefix direktori terpanjang.
# ADR-110 (amandemen REVIEW-F1-SEC8 LP8-16..20): loop 1500 -> 1800 (pairing setiap hasil tool +
# redaksi lintas-delta; terukur 1.757; Σ core 35.200 -> 35.500 <= 47.000).
loop              1800 internal/loop
plan               600 internal/plan
provider          2000 internal/provider
# ADR-126: provider/registry 400 -> 300 + ctxdb/limitstore 100 (storage model_limits, ADR-074; Σ tetap).
provider/registry  300 internal/provider/registry
netx              1800 internal/netx
schema            1200 internal/schema
# ADR-119: tools 1800 -> 2200 (tool_search/tool_invoke + adaptor tool modul; Σ core 25.880 -> 26.408 <= 47.000).
tools             2200 internal/tools
# ADR-111: codetools 4500 -> 4800 (perbaikan REVIEW-F1-SEC2; Σ core 33.900 -> 34.200 <= 47.000).
# ADR-108: codetools 4800 -> 5250 (prefilter CT-01..03; Σ core 34.200 -> 34.650 <= 47.000).
# ADR-108 amendment: codetools 5250 -> 5350 (open relatif fd direktori + deny pruning; terukur 5.292; Σ core 34.900 -> 35.000 <= 47.000).
codetools         5350 internal/codetools
# ADR-081: exec 3000 -> 3500 + exec/classify 1500 (Σ core 31.450 -> 33.450 <= 47.000).
# ADR-106 butir 10: exec 3500 -> 3400, exec/classify 1500 -> 1600 (Σ core tetap).
# ADR-112: exec/classify 1600 -> 1800 untuk aturan keamanan stack classify + shell_allow argv-persis (Σ core 35.000 -> 35.200).
exec              3400 internal/exec
exec/classify     1800 internal/exec/classify
# ADR-097 butir 12: sandbox+redact 1300 -> 1450 (S16-7, codetools deny fast path, redact prefilter; Σ core 33.750 -> 33.900).
# ADR-108: sandbox+redact 1450 -> 1700 (dir-fd walk fast path; Σ core 34.650 -> 34.900 <= 47.000).
sandbox+redact    1700 internal/sandbox internal/redact
boundary           150 internal/boundary
# ctxdb: ADR-049 (2.800) → ADR-087 (3.100) → ADR-118 (3.400) → ADR-118 amandemen (3.500: History/Fork/Search + Recall #152 in one package; terukur 3.418).
ctxdb             3500 internal/ctxdb
